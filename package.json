{
  "name": "sparkle-motion-vizualizer",
  "version": "0.1.0",
  "description": "Small embeddable animated graph visualization library — pipelines, tokens, expand/collapse, condense.",
  "keywords": [
    "graph",
    "visualization",
    "animation",
    "pipeline",
    "dag",
    "diagram",
    "svg",
    "storyboard"
  ],
  "author": "Esteban Selaya <engineering@estebanselaya.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Selaya/research-graph-library.git"
  },
  "homepage": "https://github.com/Selaya/research-graph-library#readme",
  "bugs": {
    "url": "https://github.com/Selaya/research-graph-library/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/smv.iife.min.js",
  "jsdelivr": "./dist/smv.iife.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./preset-pipeline": "./src/preset-pipeline.js",
    "./export": {
      "types": "./types/export.d.ts",
      "default": "./src/export.js"
    },
    "./a11y-table": {
      "types": "./types/a11y-table.d.ts",
      "default": "./src/a11y-table.js"
    },
    "./adapters/dagre": {
      "types": "./types/adapters-dagre.d.ts",
      "default": "./src/adapters/dagre.js"
    }
  },
  "bin": {
    "smv-pack": "bin/smv-pack.mjs",
    "smv-record": "bin/smv-record.mjs",
    "smv-fit": "bin/smv-fit.mjs"
  },
  "files": [
    "src",
    "dist",
    "types",
    "bin",
    "scripts/harness.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/*.test.js\"",
    "size": "node scripts/size-budget.js",
    "types": "tsc -p types",
    "check": "npm run test && npm run build && npm run size",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run types"
  },
  "license": "MIT",
  "peerDependencies": {
    "@dagrejs/dagre": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "esbuild": "0.28.2",
    "playwright-core": "^1.62.1",
    "typescript": "5.9.3"
  }
}
